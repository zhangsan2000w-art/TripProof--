{
  "name": "tripproof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "build": "next build",
    "start": "tsx scripts/start.ts",
    "start:web": "tsx scripts/start.ts --web-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "goldset": "tsx --env-file=.env.local scripts/goldset.ts",
    "golden": "tsx --env-file=.env.local scripts/golden.ts",
    "samples:export": "tsx --env-file=.env.local scripts/export-samples.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "test:extensions": "tsx --env-file=.env.local scripts/extensions.ts",
    "test:images": "tsx --env-file=.env.local scripts/image-smoke.ts",
    "test:ux": "tsx --env-file=.env.local scripts/ux-smoke.ts",
    "test:access": "tsx --env-file=.env.local scripts/access-smoke.ts",
    "deploy:modelscope:prepare": "tsx scripts/prepare-modelscope.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "openai": "7.41.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "tencentcloud-sdk-nodejs-wsa": "^4.1.329",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@playwright/test": "1.56.1"
  }
}
