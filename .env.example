OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_EXTRACT_MODEL=gpt-6.1-sol
LLM_FACT_MODEL=gpt-6.1-sol
LLM_EXPLAIN_MODEL=gpt-6.1-sol
# Optional; defaults to LLM_FACT_MODEL, then gpt-6.1-sol.
LLM_AGENT_MODEL=
LLM_TIMEOUT_MS=120000
# Tune only within the model/search providers' actual quotas.
LLM_FACT_CONCURRENCY=6
LLM_PLANNER_CONCURRENCY=1
VENUE_CONCURRENCY=6
PAGE_CONCURRENCY=12
SEARCH_CONCURRENCY=4
SEARCH_STARTS_PER_SECOND=4
WSA_AUTH_MODE=api-key
WSA_API_KEY=
WSA_SEARCH_ENABLED=1
WSA_TIER=standard
# Optional extra search source; disabled when the key is empty or enabled is 0.
DEEPSEEK_API_KEY=
DEEPSEEK_SEARCH_ENABLED=1
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
DATABASE_PATH=.data/tripproof.db
APP_URL=http://localhost:3000
SESSION_DAILY_LIMIT=10
SESSION_MESSAGE_LIMIT=60
SEARCH_DAILY_LIMIT=1000
SEARCH_TOTAL_LIMIT=6000
USER_AGENT=TripProof/1.0 (+https://example.com; contact=you@example.com)
PORT=3000
# Optional locally. Set ACCESS_REQUIRED=1 on any public trial deployment.
ACCESS_REQUIRED=0
ACCESS_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ACCESS_SESSION_SECRET=
# ModelScope Docker image sets this during both build and runtime. Leave unset for Node/VPS.
APP_FRAME_MODE=
