体适用景点，不提取为西湖全域免预约规则。","车辆单双号限行及西湖通申领属于车辆通行规则，不等同于场馆开放时间或普通个人游客入园预约规则。","临时关闭公告涉及所属公园景点、博物馆、游步道及游览服务，未明确西湖全域关闭；未提供恢复开放公告。","光明网证据正文乱码，可读passage中的关闭起始日期仅明确为7月11日，未明确年份。","一条temp_closure说法未通过引文、数字或适用范围核验，未用于判定。"],"createdAt":"2026-10-23T14:14:07.504Z"},{"venue":{"id":"25d98ba9c0b82c8c93880760","key":"杭州:断桥残雪","canonicalName":"断桥残雪","city":"杭州","officialDomain":null,"officialEvidenceId":null,"investigationDates":["2026-10-24"]},"facts":[{"id":"bb008156-f5d2-49ee-84a9-93afc597fa6a","evidenceId":"fd60670a-044c-4971-b568-1145c0f7fa93","quote":"开放时间:全天开放。","venueMatch":"exact","validFrom":null,"validTo":null,"kind":"weekly_open","payload":{"weekdays":[0,1,2,3,4,5,6],"exceptStatutoryHolidays":false},"venueId":"25d98ba9c0b82c8c93880760","quoteVerified":true,"tier":3,"domain":"baike.sogou.com","publishedAt":"2026-10-18","retrievedAt":"2026-10-23T14:14:08.461Z","linkStatus":"ok"},{"id":"84192083-e2a4-4d8d-8ec2-30740e47b199","evidenceId":"9d107123-73c5-46ca-ab2b-91ae54b9aed2","quote":"开放时间： 1/1-12/31；周一至周日；全天开放","venueMatch":"exact","validFrom":null,"validTo":null,"kind":"weekly_open","payload":{"weekdays":[0,1,2,3,4,5,6],"exceptStatutoryHolidays":false},"venueId":"25d98ba9c0b82c8c93880760","quoteVerified":true,"tier":3,"domain":"piao.qunar.com","publishedAt":null,"retrievedAt":"2026-10-23T14:14:08.462Z","linkStatus":"ok"},{"id":"a5d7f169-3973-45a3-bfbd-c6540d3deb0a","evidenceId":"3238afe9-3764-43ca-882f-5e410c861309","quote":"开放时间 全天开放","venueMatch":"exact","validFrom":null,"validTo":null,"kind":"weekly_open","payload":{"weekdays":[0,1,2,3,4,5,6],"exceptStatutoryHolidays":false},"venueId":"25d98ba9c0b82c8c93880760","quoteVerified":true,"tier":3,"domain":"baike.baidu.com","publishedAt":"2026-07-24","retrievedAt":"2026-10-23T14:14:08.461Z","linkStatus":"ok"},{"id":"1b1c582f-21c3-4827-bb1c-423fb7901ca8","evidenceId":"8b0312f7-4b79-4aaa-ac8b-2dce5476635a","quote":"开放时间 周一至周日,全天开放。","venueMatch":"exact","validFrom":null,"validTo":null,"kind":"weekly_open","payload":{"weekdays":[0,1,